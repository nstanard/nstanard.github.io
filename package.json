{
  "name": "gatsby-starter-minimal",
  "version": "1.0.0",
  "private": true,
  "description": "A Gatsby starter with no plugins and a single welcome page.",
  "author": "Laurie Barth",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "deploy:public": "gatsby build --prefix-paths && gh-pages -d public",
    "deploy:main": "gatsby build && gh-pages -d public -b main"
  },
  "license": "0BSD",
  "dependencies": {
    "gatsby": "^5.14.1",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^13.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/react": "^2.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "gatsby-plugin-image": "^3.14.0",
    "gatsby-plugin-mdx": "^5.14.0",
    "gatsby-plugin-postcss": "^6.14.0",
    "gatsby-plugin-sharp": "^5.14.0",
    "gatsby-source-filesystem": "^5.14.0",
    "gatsby-transformer-sharp": "^5.14.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.31",
    "postcss-nested": "^7.0.2",
    "tailwindcss": "^3.4.1"
  }
}
